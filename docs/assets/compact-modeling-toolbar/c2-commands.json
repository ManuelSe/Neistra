{
  "environment": {
    "MOLWEAVE_DATA_DIR": "/tmp/neistra93-c2-gate/default-data",
    "MOLWEAVE_AMBERTOOLS_PREFIX": "/datadisk/dev/.neistra-tools/ambertools-24.8",
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "PLAYWRIGHT_BROWSERS_PATH": ".playwright",
    "MOLWEAVE_E2E_DATA_DIR": "/tmp/neistra93-c2-gate/browser-data",
    "MOLWEAVE_E2E_API_PORT": "14210",
    "MOLWEAVE_E2E_WORKER_PORT": "14211",
    "MOLWEAVE_E2E_WEB_PORT": "14273",
    "PLAYWRIGHT_JSON_OUTPUT_NAME": "/tmp/neistra93-c2-gate/browser.json"
  },
  "steps": [
    {
      "label": "focused",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "exec",
        "vitest",
        "run",
        "minimization",
        "movement-navigation",
        "molecular-edit-panel",
        "viewer-presentation"
      ]
    },
    {
      "label": "lint",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "lint"
      ]
    },
    {
      "label": "types",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "typecheck"
      ]
    },
    {
      "label": "frontend",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "test"
      ]
    },
    {
      "label": "build",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "build"
      ]
    },
    {
      "label": "browser",
      "command": [
        "corepack",
        "pnpm",
        "exec",
        "playwright",
        "test",
        "tests/e2e/modeling-toolbar.spec.ts",
        "tests/e2e/viewer-transform-toolbar.spec.ts",
        "tests/e2e/interactive-selection-transform.spec.ts",
        "tests/e2e/minimization-accessibility.spec.ts",
        "tests/e2e/molecular-editing.spec.ts",
        "tests/e2e/quick-minimization.spec.ts",
        "--reporter=list,json"
      ]
    },
    {
      "label": "diff",
      "command": [
        "git",
        "diff",
        "--check"
      ]
    }
  ]
}
