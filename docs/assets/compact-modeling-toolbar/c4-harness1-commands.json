{
  "environment": {
    "MOLWEAVE_DATA_DIR": "/tmp/neistra93-c4-harness1/default-data",
    "MOLWEAVE_MINIMIZATION_MAX_RSS_BYTES": "4294967296",
    "MOLWEAVE_JOB_PLUGIN_ALLOWLIST": "molweave.demo,molweave.minimization",
    "MOLWEAVE_JOB_PLUGIN_TARGETS": "molweave_demo_plugin.plugin:plugin,molweave_core.minimization.plugin:plugin",
    "MOLWEAVE_AMBERTOOLS_PREFIX": "/datadisk/dev/.neistra-tools/ambertools-24.8",
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "PLAYWRIGHT_BROWSERS_PATH": ".playwright",
    "MOLWEAVE_E2E_DATA_DIR": "/tmp/neistra93-c4-harness1/browser-data",
    "MOLWEAVE_E2E_API_PORT": "15510",
    "MOLWEAVE_E2E_WORKER_PORT": "15511",
    "MOLWEAVE_E2E_WEB_PORT": "15573",
    "MOLWEAVE_MINIMIZATION_EVIDENCE_DIR": "/tmp/neistra93-c4-merged4/native",
    "PLAYWRIGHT_JSON_OUTPUT_NAME": "/tmp/neistra93-c4-harness1/browser.json"
  },
  "steps": [
    {
      "label": "python",
      "command": [
        ".venv/bin/uv",
        "run",
        "pytest",
        "tests/integration/test_minimization_jobs.py",
        "-q"
      ]
    },
    {
      "label": "ruff",
      "command": [
        ".venv/bin/uv",
        "run",
        "ruff",
        "check",
        "."
      ]
    },
    {
      "label": "lint",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "lint"
      ]
    },
    {
      "label": "types",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "typecheck"
      ]
    },
    {
      "label": "frontend",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "test"
      ]
    },
    {
      "label": "build",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "build"
      ]
    },
    {
      "label": "browser",
      "command": [
        "corepack",
        "pnpm",
        "exec",
        "playwright",
        "test",
        "tests/e2e/viewer-notifications.spec.ts",
        "--reporter=list,json"
      ]
    },
    {
      "label": "diff",
      "command": [
        "git",
        "diff",
        "--check"
      ]
    }
  ]
}
