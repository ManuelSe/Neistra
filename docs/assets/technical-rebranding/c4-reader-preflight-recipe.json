{
  "label": "c4-reader-preflight",
  "require_clean": true,
  "environment": {
    "NEISTRA_AMBERTOOLS_PREFIX": "/datadisk/dev/.neistra-tools/ambertools-24.8",
    "PLAYWRIGHT_BROWSERS_PATH": "/datadisk/dev/neistra/.playwright"
  },
  "steps": [
    {
      "label": "uv",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "sync",
        "--frozen"
      ]
    },
    {
      "label": "pnpm",
      "command": [
        "corepack",
        "pnpm",
        "install",
        "--frozen-lockfile"
      ]
    },
    {
      "label": "migration",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "alembic",
        "upgrade",
        "head"
      ],
      "environment": {
        "NEISTRA_DATA_DIR": "/tmp/neistra99-c4-reader-preflight/database",
        "PYTHONPATH": "/datadisk/dev/neistra/apps/api/src:/datadisk/dev/neistra/packages/neistra_core/src:/datadisk/dev/neistra/packages/neistra_demo_plugin/src"
      }
    },
    {
      "label": "downgrade",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "alembic",
        "downgrade",
        "base"
      ],
      "environment": {
        "NEISTRA_DATA_DIR": "/tmp/neistra99-c4-reader-preflight/database",
        "PYTHONPATH": "/datadisk/dev/neistra/apps/api/src:/datadisk/dev/neistra/packages/neistra_core/src:/datadisk/dev/neistra/packages/neistra_demo_plugin/src"
      }
    },
    {
      "label": "remigration",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "alembic",
        "upgrade",
        "head"
      ],
      "environment": {
        "NEISTRA_DATA_DIR": "/tmp/neistra99-c4-reader-preflight/database",
        "PYTHONPATH": "/datadisk/dev/neistra/apps/api/src:/datadisk/dev/neistra/packages/neistra_core/src:/datadisk/dev/neistra/packages/neistra_demo_plugin/src"
      }
    },
    {
      "label": "ruff",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "ruff",
        "check",
        "."
      ]
    },
    {
      "label": "mypy",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "mypy",
        "apps/api",
        "packages/neistra_core",
        "packages/neistra_demo_plugin"
      ]
    },
    {
      "label": "python",
      "command": [
        "/datadisk/dev/neistra/.venv/bin/uv",
        "run",
        "pytest"
      ],
      "environment": {
        "MOLWEAVE_DATA_DIR": "/tmp/neistra99-c4-reader-preflight/database"
      }
    },
    {
      "label": "lint",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "lint"
      ]
    },
    {
      "label": "types",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "typecheck"
      ]
    },
    {
      "label": "web",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "test"
      ]
    },
    {
      "label": "supervisor",
      "command": [
        "corepack",
        "pnpm",
        "test:dev"
      ]
    },
    {
      "label": "build",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "build"
      ]
    },
    {
      "label": "browser",
      "command": [
        "corepack",
        "pnpm",
        "exec",
        "playwright",
        "test"
      ],
