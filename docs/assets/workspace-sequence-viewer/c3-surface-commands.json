{
  "environment": {
    "MOLWEAVE_DATA_DIR": "/tmp/neistra95-c3-surface/default-data",
    "MOLWEAVE_E2E_DATA_DIR": "/tmp/neistra95-c3-surface/browser-data",
    "MOLWEAVE_E2E_API_PORT": "19810",
    "MOLWEAVE_E2E_WORKER_PORT": "19811",
    "MOLWEAVE_E2E_WEB_PORT": "19873",
    "PLAYWRIGHT_BROWSERS_PATH": ".playwright",
    "MOLWEAVE_AMBERTOOLS_PREFIX": "/datadisk/dev/.neistra-tools/ambertools-24.8",
    "OPENBLAS_NUM_THREADS": "1",
    "OMP_NUM_THREADS": "1",
    "PLAYWRIGHT_JSON_OUTPUT_NAME": "/tmp/neistra95-c3-surface/browser.json"
  },
  "steps": [
    {
      "label": "focused",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "exec",
        "vitest",
        "run",
        "sequence",
        "project-workspace",
        "selection-gestures",
        "structure-loading"
      ]
    },
    {
      "label": "lint",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "lint"
      ]
    },
    {
      "label": "types",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "typecheck"
      ]
    },
    {
      "label": "frontend",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "test"
      ]
    },
    {
      "label": "build",
      "command": [
        "corepack",
        "pnpm",
        "--dir",
        "apps/web",
        "build"
      ]
    },
    {
      "label": "browser",
      "command": [
        "corepack",
        "pnpm",
        "exec",
        "playwright",
        "test",
        "tests/e2e/rebranding-surfaces.spec.ts",
        "--grep",
        "reviews all Neistra workflow surfaces",
        "--reporter=list,json",
        "--output=/tmp/neistra95-c3-surface/browser-results"
      ]
    },
    {
      "label": "diff",
      "command": [
        "git",
        "diff",
        "--check"
      ]
    }
  ]
}
